# progs4u: development image — the production image plus what the repo's test suites
# need inside a container (frontend devDependencies and the Playwright browsers), so a
# change can be self-verified without a toolchain on the host. Built by
# compose.dev.yaml from ./dev; never deployed.
#
# Run the unit tests:  docker compose -f compose.dev.yaml exec tabs-dev deno test --allow-all
# Run the e2e suite:   docker compose -f compose.dev.yaml exec tabs-dev sh -c \
#                        'cd frontend && deno run -A npm:@playwright/test test --project=chromium'
# (the suite starts its own demo-mode backend on 127.0.0.1:47779 inside the container)
FROM progs4u/its-mytabs:pdf

USER root

# Chromium is downloaded here rather than into the user's cache so the container user
# can read it; --with-deps pulls the shared libraries it links against.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY --chown=deno:deno frontend /app/frontend

WORKDIR /app/frontend
RUN deno install && \
    deno run -A npm:playwright@1.62.1 install --with-deps chromium && \
    chmod -R a+rX /ms-playwright && \
    rm -rf /root/.npm /var/lib/apt/lists/*

WORKDIR /app
